# URL publique du site, sans slash final (canonical, sitemap, Open Graph, JSON-LD).
# Obligatoire en production. Exemple : https://digistock.ma
NEXT_PUBLIC_SITE_URL=

# Optionnel : remplace le lien de l'installateur défini dans src/config/product.ts
# (par défaut : la dernière release GitHub de DigiStock).
NEXT_PUBLIC_DOWNLOAD_URL=

# Code de vérification Google Search Console (balise meta, valeur de content="...").
NEXT_PUBLIC_GSC_VERIFICATION=

# Code de vérification Bing Webmaster Tools (balise msvalidate.01).
NEXT_PUBLIC_BING_VERIFICATION=

# Vercel Analytics (sans cookie) : mettre 1 après l'avoir activé dans le tableau de bord Vercel.
NEXT_PUBLIC_VERCEL_ANALYTICS=

# Google Analytics 4 (optionnel). Exemple : G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
